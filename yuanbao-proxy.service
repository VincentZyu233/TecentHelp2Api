[Unit]
Description=Yuanbao OpenAI Compatible Proxy
After=network.target

[Service]
Type=simple
User=node
WorkingDirectory=/opt/yuanbao-openai-proxy
ExecStart=/usr/bin/node proxy.js
Restart=on-failure
RestartSec=5
Environment=PORT=8080
# Environment=API_KEY=sk-your-secret-key
# Environment=DEFAULT_USERID=your-userid

[Install]
WantedBy=multi-user.target
